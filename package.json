{
  "name": "@netpeer/swarm",
  "version": "0.10.0",
  "exports": {
    "./client": {
      "import": "./exports/client.js",
      "types": "./exports/client/client.d.ts"
    },
    "./peer": {
      "import": "./exports/peer.js",
      "types": "./exports/client/peer.d.ts"
    },
    "./server": {
      "import": "./exports/server.js",
      "types": "./exports/server/server.d.ts"
    },
    "./browser": {
      "import": "./exports/browser/client.js",
      "types": "./exports/client/client.d.ts"
    }
  },
  "browser": "./exports/browser/client.js",
  "files": [
    "exports",
    "docs/webtransport-relay.md",
    "docs/release-0.10.md",
    "spawn-star.js",
    "spawn-stars.js",
    "run-server.js",
    "relay-config.js",
    "relay-service.js",
    "hosted-star.js",
    "run-webtransport.js"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "c": "rollup -c",
    "w": "rollup -c -w",
    "build": "rollup -c",
    "prepack": "npm run build && npm run test:transport && npm run test:config",
    "start": "node ./run-server.js",
    "start:webtransport": "node ./run-webtransport.js",
    "start:star": "node ./run-server.js",
    "test:config": "node --test test/relay-config.test.js",
    "test:auto": "node --test test/auto-relay.test.js",
    "test:transport": "node --test test/transport.test.js",
    "test:http3": "node test/webtransport-http3.js",
    "test:authorization": "node test/relay-authorization.js",
    "test": "node ./test/run-all.js",
    "test:unit": "node ./test/unit-latency.js",
    "test:integration": "node ./test/run-all.js --integration-only",
    "benchmark:wrtc": "node ./test/benchmark-wrtc.js",
    "benchmark:webtransport": "node ./test/benchmark-webtransport.js"
  },
  "description": "peer discovery client & server",
  "repository": "https://github.com/netpeer/swarm",
  "author": "vandeurenglenn <vandeurenglenn@gmail.com>",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/pako": "^2.0.4",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@fails-components/webtransport": "^1.6.11",
    "@vandeurenglenn/debug": "^1.4.0",
    "@vandeurenglenn/little-pubsub": "^1.5.2",
    "pako": "^2.1.0",
    "socket-request-client": "^2.1.3",
    "socket-request-server": "^1.7.3"
  },
  "optionalDependencies": {
    "@vandeurenglenn/wrtc": "^0.7.2",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.11"
  },
  "peerDependencies": {
    "@koush/wrtc": "^0.5.3"
  },
  "peerDependenciesMeta": {
    "@koush/wrtc": {
      "optional": true
    }
  }
}
